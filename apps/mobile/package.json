    "@supabase/supabase-js": "2.117.2",
    "@vores-kok/database": "workspace:*",
    "@vores-kok/domain": "workspace:*",
    "@vores-kok/ui": "workspace:*",
    "@vores-kok/validation": "workspace:*",
    "expo": "57.0.25",
    "expo-constants": "~57.0.19",
    "expo-crypto": "~57.0.3",
    "expo-font": "~57.0.4",
    "expo-image": "~57.0.5",
